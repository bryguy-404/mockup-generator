# Copy this file to .env.local and add your real API keys.
# OpenAI is the default generation engine.
# Firecrawl is optional but recommended for better website research.
# Anthropic: https://console.anthropic.com
# OpenAI: https://platform.openai.com/api-keys
# Firecrawl: https://www.firecrawl.dev
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
FIRECRAWL_API_KEY=your-firecrawl-api-key-here

# Optional model and reasoning overrides.
# Keep the OpenAI model, effort, and mode as a matched set.
# OPENAI_MOCKUP_MODEL=gpt-5.6-sol
# OPENAI_REASONING_EFFORT=max
# OPENAI_REASONING_MODE=pro
# OPENAI_SERVICE_TIER=fast
# ANTHROPIC_MOCKUP_MODEL=claude-fable-5
# ANTHROPIC_EXPORT_MODEL=claude-fable-5
# ANTHROPIC_REASONING_EFFORT=max

# Optional OpenAI background-response timing overrides (milliseconds).
# OPENAI_BACKGROUND_POLL_INTERVAL_MS=2000
# OPENAI_BACKGROUND_MAX_WAIT_MS=1800000
# OPENAI_HTTP_REQUEST_TIMEOUT_MS=60000
